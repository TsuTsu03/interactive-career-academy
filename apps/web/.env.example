# Copy to .env.local and fill in. Nothing here is read at build time except
# SITE_URL, so a missing value fails at request time with an honest
# disconnected state rather than a broken build.
#
# The same four Supabase and site values go into the host's environment
# settings for a deployment. See README.md, "Continuous integration, versions,
# and deployment".

# --- Supabase -----------------------------------------------------------
# The project API URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# The sb_publishable_... key. Used for anonymous reads and for the two
# rate-limited RPCs that record feedback and claim an email link.
SUPABASE_PUBLISHABLE_KEY=

# The sb_secret_... key. Server-only: it mints certificates after the server
# revalidates every course, capstone, and project link. Never give this one a
# NEXT_PUBLIC_ prefix, and never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Site ---------------------------------------------------------------
# The public origin, with no trailing slash. Must be https unless it is
# localhost, or the app falls back to http://localhost:3000 rather than
# emitting a wrong canonical URL.
#
# This one value drives canonical URLs, the sitemap, the web manifest, the
# share card, and the auth redirects at once, so a wrong value breaks sign-in
# and SEO together. The same origin must be the Supabase Site URL, and
# <origin>/** must be in the Supabase redirect allow-list.
SITE_URL=http://localhost:3000

# --- Feedback email (optional) ------------------------------------------
# Without both RESEND_API_KEY and FEEDBACK_EMAIL_TO, feedback is still stored
# in the database; only the email notification is skipped.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=

# Optional. Defaults to CodeDaddy Feedback <onboarding@resend.dev>, which
# works without a verified domain but is not a good sending address to keep.
FEEDBACK_EMAIL_FROM=
