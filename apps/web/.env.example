# Copy to .env.local and fill in. Nothing here is read at build time except
# SITE_URL, so a missing value fails at request time with an honest
# disconnected state rather than a broken build.
#
# The same values go into the host's environment settings for a deployment.
# See README.md, "Continuous integration, versions, and deployment".

# --- MongoDB ------------------------------------------------------------
# The Atlas connection string, from Atlas -> Cluster -> Connect -> Drivers.
# It contains the database user's password, so it is server-only: never give
# it a NEXT_PUBLIC_ prefix. Without it, account features show as not set up.
MONGODB_URI=

# Optional. The database name inside the cluster. Defaults to codedaddy.
MONGODB_DB=

# Optional, local development only. Some machines run a local DNS resolver
# that refuses the SRV lookup a mongodb+srv:// address needs, and Node then
# fails with "querySrv ECONNREFUSED". Comma-separated resolvers to use
# instead, e.g. 1.1.1.1,8.8.8.8. Leave it unset on the deployment.
MONGODB_DNS_SERVERS=

# --- Sign-in providers --------------------------------------------------
# Each provider switches on only when both of its values are present.
#
# GitHub: Settings -> Developer settings -> OAuth Apps. The callback URL is
# <SITE_URL>/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google: Google Cloud console -> APIs & Services -> Credentials -> OAuth
# client (Web application). The authorized redirect URI is
# <SITE_URL>/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links are sent through Resend with RESEND_API_KEY (below).
# Resend's shared sender only delivers to the Resend account owner, so real
# learners receive links only once this is an address on a domain verified
# in Resend, e.g. CodeDaddy <signin@your-domain.com>.
AUTH_EMAIL_FROM=

# --- Site ---------------------------------------------------------------
# The public origin, with no trailing slash. Must be https unless it is
# localhost, or the app falls back to http://localhost:3000 rather than
# emitting a wrong canonical URL.
#
# This one value drives canonical URLs, the sitemap, the web manifest, the
# share card, and the sign-in callback URLs at once, so a wrong value breaks
# sign-in and SEO together. The GitHub and Google callback URLs above must use
# this same origin.
SITE_URL=http://localhost:3000

# --- Email (Resend) -----------------------------------------------------
# RESEND_API_KEY sends the sign-in links and the feedback notifications.
# Without FEEDBACK_EMAIL_TO, feedback is still stored in the database; only
# the email notification is skipped.
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=

# Optional. Defaults to CodeDaddy Feedback <onboarding@resend.dev>, which
# works without a verified domain but is not a good sending address to keep.
FEEDBACK_EMAIL_FROM=
